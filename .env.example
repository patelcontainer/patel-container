NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
NEXT_PUBLIC_SITE_URL=https://www.vahanacontainers.com
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Cloudflare Turnstile on the contact form. Leave both empty to switch it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secret key.
TURNSTILE_SECRET=
# Optional: comma-separated hostnames allowed to submit (defaults to the live domains).
TURNSTILE_HOSTNAMES=
